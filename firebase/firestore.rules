rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validPublicProfile(profile) {
        return profile.keys().hasOnly([
            'uid',
            'displayName',
            'username',
            'photoURL',
            'bio',
            'country',
            'city',
            'languages',
            'interests',
            'roles',
            'accountStatus',
            'verificationStatus',
            'createdAt',
            'updatedAt'
          ])
          && profile.keys().hasAll([
            'uid',
            'displayName',
            'username',
            'languages',
            'interests',
            'roles',
            'accountStatus',
            'verificationStatus',
            'createdAt',
            'updatedAt'
          ])
          && profile.uid == userId
          && profile.displayName is string
          && profile.displayName.size() > 0
          && profile.displayName.size() <= 100
          && profile.username is string
          && profile.username.matches('^[a-z0-9_]{3,20}$')
          && profile.languages is list
          && profile.languages.size() <= 50
          && profile.interests is list
          && profile.interests.size() <= 50
          && profile.roles is list
          && profile.roles.size() >= 1
          && profile.roles.size() <= 2
          && profile.roles.hasOnly(['traveller', 'host'])
          && profile.accountStatus in ['active', 'suspended', 'deleted']
          && profile.verificationStatus in ['unverified', 'pending', 'verified']
          && (!('photoURL' in profile) ||
            (profile.photoURL is string && profile.photoURL.size() <= 2048))
          && (!('bio' in profile) ||
            (profile.bio is string && profile.bio.size() <= 500))
          && (!('country' in profile) ||
            (profile.country is string && profile.country.size() <= 100))
          && (!('city' in profile) ||
            (profile.city is string && profile.city.size() <= 100))
          && profile.createdAt is timestamp
          && profile.updatedAt is timestamp;
      }

      function usernameReservationMatches(profile) {
        let reservationPath = /databases/$(database)/documents/usernames/$(profile.username);
        return existsAfter(reservationPath)
          && getAfter(reservationPath).data.uid == profile.uid;
      }

      function oldUsernameReservationReleased() {
        let reservationPath = /databases/$(database)/documents/usernames/$(resource.data.username);
        return request.resource.data.username == resource.data.username
          || !existsAfter(reservationPath);
      }

      function validNewProfile() {
        return validPublicProfile(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.roles == ['traveller']
          && request.resource.data.accountStatus == 'active'
          && request.resource.data.verificationStatus == 'unverified'
          && request.resource.data.languages == []
          && request.resource.data.interests == []
          && usernameReservationMatches(request.resource.data);
      }

      function validProfileUpdate() {
        return validPublicProfile(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.roles == resource.data.roles
          && request.resource.data.accountStatus == resource.data.accountStatus
          && request.resource.data.verificationStatus == resource.data.verificationStatus
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'username',
            'photoURL',
            'bio',
            'country',
            'city',
            'languages',
            'interests',
            'updatedAt'
          ])
          && usernameReservationMatches(request.resource.data)
          && oldUsernameReservationReleased();
      }

      function isVerified() {
        return request.auth.token.email_verified == true;
      }

      function isPublicProfile() {
        return validPublicProfile(resource.data);
      }

      allow read: if isOwner() || isPublicProfile();
      allow create: if isOwner() && validNewProfile();
      allow update: if isOwner()
        && isVerified()
        && resource.data.accountStatus == 'active'
        && validProfileUpdate();
      allow delete: if false;
    }

    match /userPrivate/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validPrivateProfile(profile) {
        return profile.keys().hasOnly([
            'uid',
            'phoneNumber',
            'privatePreferences',
            'updatedAt'
          ])
          && profile.keys().hasAll([
            'uid',
            'privatePreferences',
            'updatedAt'
          ])
          && profile.uid == userId
          && profile.privatePreferences is map
          && profile.privatePreferences.keys().size() <= 50
          && (!('phoneNumber' in profile) ||
            (profile.phoneNumber is string && profile.phoneNumber.size() <= 32))
          && profile.updatedAt is timestamp;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && validPrivateProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && validPrivateProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phoneNumber',
          'privatePreferences',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /hostProfiles/{hostUid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == hostUid;
      }

      function validLanguageAt(profile, index) {
        return profile.languages.size() <= index
          || (profile.languages[index] is string
            && profile.languages[index].matches('^[a-z]{2,3}(-[A-Z]{2})?$'));
      }

      function validHostProfile(profile) {
        return profile.keys().hasOnly([
            'uid',
            'displayName',
            'introduction',
            'languages',
            'visibility',
            'createdAt',
            'updatedAt'
          ])
          && profile.keys().hasAll([
            'uid',
            'displayName',
            'languages',
            'visibility',
            'createdAt',
            'updatedAt'
          ])
          && profile.uid == hostUid
          && profile.displayName is string
          && profile.displayName.size() > 0
          && profile.displayName.size() <= 100
          && (!('introduction' in profile) ||
            (profile.introduction is string && profile.introduction.size() <= 500))
          && profile.languages is list
          && profile.languages.size() <= 10
          && profile.languages.toSet().size() == profile.languages.size()
          && validLanguageAt(profile, 0)
          && validLanguageAt(profile, 1)
          && validLanguageAt(profile, 2)
          && validLanguageAt(profile, 3)
          && validLanguageAt(profile, 4)
          && validLanguageAt(profile, 5)
          && validLanguageAt(profile, 6)
          && validLanguageAt(profile, 7)
          && validLanguageAt(profile, 8)
          && validLanguageAt(profile, 9)
          && profile.visibility in ['private', 'public']
          && profile.createdAt is timestamp
          && profile.updatedAt is timestamp;
      }

      function hasCurrentHostConsent() {
        let consentPath = /databases/$(database)/documents/hostPrivate/$(hostUid);
        let consent = exists(consentPath) ? get(consentPath).data : null;
        return consent != null
          && consent.uid == hostUid
          && consent.termsVersion == 'host-participation-v1'
          && consent.termsDigest == '0cbe5ba16e71fe24803c9080c62e7f3eb413c8d3ae079289d51538d2a325a96b'
          && consent.consentState == 'accepted'
          && consent.eventId is string;
      }

      function hasActiveAccount() {
        let userPath = /databases/$(database)/documents/users/$(hostUid);
        let user = exists(userPath) ? get(userPath).data : null;
        return user != null && user.accountStatus == 'active';
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner()
        && request.auth.token.email_verified == true
        && hasActiveAccount()
        && hasCurrentHostConsent()
        && validHostProfile(request.resource.data)
        && request.resource.data.visibility == 'private'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && request.auth.token.email_verified == true
        && hasActiveAccount()
        && validHostProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.visibility != 'public' || hasCurrentHostConsent())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'introduction',
          'languages',
          'visibility',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /hostPrivate/{hostUid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == hostUid;
      }

      allow get, list: if isOwner();
      allow create, update, delete: if false;

      match /consentEvents/{eventId} {
        allow get, list: if request.auth != null && request.auth.uid == hostUid;
        allow create, update, delete: if false;
      }
    }

    match /usernames/{username} {
      function isReservationOwner() {
        return request.auth != null && resource.data.uid == request.auth.uid;
      }

      function profileMatchesReservationAfter() {
        let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
        return existsAfter(profilePath)
          && getAfter(profilePath).data.uid == request.auth.uid
          && getAfter(profilePath).data.username == username;
      }

      function validReservation(reservation) {
        return reservation.keys().hasOnly([
            'uid',
            'createdAt',
            'updatedAt'
          ])
          && reservation.keys().hasAll([
            'uid',
            'createdAt',
            'updatedAt'
          ])
          && username.matches('^[a-z0-9_]{3,20}$')
          && reservation.uid == request.auth.uid
          && reservation.uid is string
          && reservation.uid.size() > 0
          && reservation.uid.size() <= 128
          && reservation.createdAt is timestamp
          && reservation.updatedAt == request.time;
      }

      function deletingOldReservation() {
        let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
        return resource.data.keys().hasOnly(['uid', 'createdAt', 'updatedAt'])
          && isReservationOwner()
          && exists(profilePath)
          && get(profilePath).data.username == username
          && existsAfter(profilePath)
          && getAfter(profilePath).data.username != username;
      }

      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && validReservation(request.resource.data)
        && request.resource.data.createdAt == request.time
        && profileMatchesReservationAfter();
      allow update: if isReservationOwner()
        && validReservation(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.keys().hasOnly(['uid', 'createdAt', 'updatedAt'])
        && profileMatchesReservationAfter();
      allow delete: if deletingOldReservation();
    }

    match /listings/{listingId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == resource.data.get('hostUid', null);
      }

      function validHouseRuleAt(houseRules, index) {
        return houseRules.size() <= index
          || (houseRules[index] is string
            && houseRules[index].matches('(?s)^.{5,200}$'));
      }

      function validOptionalTimestamp(listing, field) {
        return !(field in listing)
          || listing[field] == null
          || listing[field] is timestamp;
      }

      function validListingFields(listing) {
        return listing.keys().hasOnly([
            'listingId',
            'hostUid',
            'title',
            'description',
            'accommodationType',
            'country',
            'city',
            'region',
            'areaDescription',
            'guestCapacity',
            'bedrooms',
            'beds',
            'bathrooms',
            'amenities',
            'houseRules',
            'status',
            'createdAt',
            'updatedAt',
            'publishedAt',
            'pausedAt',
            'archivedAt'
          ])
          && listing.keys().hasAll([
            'listingId',
            'hostUid',
            'title',
            'description',
            'accommodationType',
            'country',
            'city',
            'guestCapacity',
            'bedrooms',
            'beds',
            'bathrooms',
            'amenities',
            'houseRules',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && listing.listingId == listingId
          && listing.listingId is string
          && listing.hostUid is string
          && listing.hostUid.size() >= 1
          && listing.hostUid.size() <= 128;
      }

      function validListingDescription(listing) {
        return listing.title is string
          && listing.title.size() >= 10
          && listing.title.size() <= 100
          && listing.description is string
          && listing.description.size() >= 50
          && listing.description.size() <= 2000
          && listing.accommodationType in ['private_room', 'shared_room', 'entire_home', 'guest_house', 'farm_stay', 'other']
          && listing.country is string
          && listing.country.size() >= 2
          && listing.country.size() <= 100
          && listing.city is string
          && listing.city.size() >= 2
          && listing.city.size() <= 100
          && (!('region' in listing) ||
            (listing.region is string
              && listing.region.size() >= 1
              && listing.region.size() <= 100))
          && (!('areaDescription' in listing) ||
            (listing.areaDescription is string
              && listing.areaDescription.size() >= 1
              && listing.areaDescription.size() <= 200));
      }

      function validListingCapacity(listing) {
        return listing.guestCapacity is number
          && listing.guestCapacity % 1 == 0
          && listing.guestCapacity >= 1
          && listing.guestCapacity <= 10
          && listing.bedrooms is number
          && listing.bedrooms % 1 == 0
          && listing.bedrooms >= 0
          && listing.bedrooms <= 10
          && listing.beds is number
          && listing.beds % 1 == 0
          && listing.beds >= 1
          && listing.beds <= 15
          && listing.bathrooms is number
          && listing.bathrooms >= 1
          && listing.bathrooms <= 10;
      }

      function validListingAmenities(listing) {
        return listing.amenities is list
          && listing.amenities.size() <= 30
          && listing.amenities.toSet().hasOnly(['wifi', 'kitchen', 'ac', 'heating', 'tv', 'laundry', 'parking', 'pool', 'gym', 'pet_friendly', 'hot_water', 'elevator', 'bathtub', 'shower', 'dishwasher', 'microwave', 'oven', 'refrigerator', 'freezer', 'balcony', 'garden', 'workspace', 'iron', 'games', 'bbq', 'outdoor_furniture', 'fireplace', 'safe', 'crib', 'high_chair']);
      }

      function validListingHouseRules(listing) {
        let houseRules = listing.houseRules;
        return houseRules is list
          && houseRules.size() <= 15
          && validHouseRuleAt(houseRules, 0)
          && validHouseRuleAt(houseRules, 1)
          && validHouseRuleAt(houseRules, 2)
          && validHouseRuleAt(houseRules, 3)
          && validHouseRuleAt(houseRules, 4)
          && validHouseRuleAt(houseRules, 5)
          && validHouseRuleAt(houseRules, 6)
          && validHouseRuleAt(houseRules, 7)
          && validHouseRuleAt(houseRules, 8)
          && validHouseRuleAt(houseRules, 9)
          && validHouseRuleAt(houseRules, 10)
          && validHouseRuleAt(houseRules, 11)
          && validHouseRuleAt(houseRules, 12)
          && validHouseRuleAt(houseRules, 13)
          && validHouseRuleAt(houseRules, 14);
      }

      function validListingTimestamps(listing) {
        return listing.status in ['draft', 'published', 'paused', 'archived']
          && listing.createdAt is timestamp
          && listing.updatedAt is timestamp
          && validOptionalTimestamp(listing, 'publishedAt')
          && validOptionalTimestamp(listing, 'pausedAt')
          && validOptionalTimestamp(listing, 'archivedAt');
      }

      function validListing(listing) {
        return validListingFields(listing)
          && validListingDescription(listing)
          && validListingCapacity(listing)
          && validListingAmenities(listing)
          && validListingHouseRules(listing)
          && validListingTimestamps(listing);
      }

      function hasCurrentHostConsent(hostUid) {
        let consentPath = /databases/$(database)/documents/hostPrivate/$(hostUid);
        let consent = exists(consentPath) ? get(consentPath).data : null;
        return consent != null
          && consent.uid == hostUid
          && consent.termsVersion == 'host-participation-v1'
          && consent.termsDigest == '0cbe5ba16e71fe24803c9080c62e7f3eb413c8d3ae079289d51538d2a325a96b'
          && consent.consentState == 'accepted'
          && consent.eventId is string;
      }

      function hasActiveAccount(hostUid) {
        let userPath = /databases/$(database)/documents/users/$(hostUid);
        let user = exists(userPath) ? get(userPath).data : null;
        return user != null && user.accountStatus == 'active';
      }

      function validNewDraft() {
        let listing = request.resource.data;
        return listing.hostUid == request.auth.uid
          && listing.status == 'draft'
          && listing.createdAt == request.time
          && listing.updatedAt == request.time
          && (!('publishedAt' in listing) || listing.publishedAt == null)
          && (!('pausedAt' in listing) || listing.pausedAt == null)
          && (!('archivedAt' in listing) || listing.archivedAt == null)
          && validListing(listing);
      }

      function validDraftUpdate() {
        let listing = request.resource.data;
        return listing.updatedAt == request.time
          && listing.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'description',
            'accommodationType',
            'country',
            'city',
            'region',
            'areaDescription',
            'guestCapacity',
            'bedrooms',
            'beds',
            'bathrooms',
            'amenities',
            'houseRules',
            'updatedAt'
          ])
          && validListing(listing);
      }

      allow get: if request.auth != null && isOwner();
      allow list: if isOwner();
      allow create: if request.auth != null
        && hasActiveAccount(request.auth.uid)
        && hasCurrentHostConsent(request.auth.uid)
        && exists(/databases/$(database)/documents/hostProfiles/$(request.auth.uid))
        && validNewDraft();
      allow update: if request.auth != null
        && isOwner()
        && resource.data.status == 'draft'
        && validDraftUpdate();
      allow delete: if false;
    }

    match /hostingRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.travellerUid == request.auth.uid
          || resource.data.hostUid == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
