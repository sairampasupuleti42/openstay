rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isVerified() {
        return request.auth.token.email_verified == true;
      }

      function validProfile() {
        return request.resource.data.keys().hasOnly([
            'displayName',
            'homeBase',
            'bio',
            'onboardingComplete',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'displayName',
            'homeBase',
            'bio',
            'onboardingComplete',
            'updatedAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.homeBase is string
          && request.resource.data.homeBase.size() > 0
          && request.resource.data.homeBase.size() <= 100
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 500
          && request.resource.data.onboardingComplete == true
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isOwner() && isVerified();
      allow create, update: if isOwner() && isVerified() && validProfile();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
